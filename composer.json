{
    "name": "alveby/atrium-reviews",
    "description": "Reviews for Atrium: moderation, 1-5 ratings, about the site or any record, with schema.org AggregateRating",
    "type": "atrium-module",
    "license": "MIT",
    "homepage": "https://github.com/AlveBy/atrium",
    "support": {
        "issues": "https://github.com/AlveBy/atrium/issues",
        "source": "https://github.com/AlveBy/atrium"
    },
    "keywords": [
        "laravel",
        "admin",
        "cms",
        "reviews",
        "ratings",
        "multisite",
        "i18n"
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^13.0",
        "alveby/atrium": "^0.1"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "suggest": {
        "alveby/atrium-theme": "Shows the reviews under the record pages of the public site"
    },
    "autoload": {
        "psr-4": {
            "Atrium\\Reviews\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atrium\\Reviews\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Atrium\\Reviews\\ReviewsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
